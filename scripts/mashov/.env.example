# Copy this file to .env in the same folder and fill in real values.
# Never commit the real .env file — it holds your actual Mashov password.

# סמל מוסד — school code, visible on the Mashov login page
MASHOV_SEMEL=
# Mashov username and password — a staff login with school-wide access
MASHOV_USERNAME=
MASHOV_PASSWORD=
# Optional — school year like 2026 for the 2026/27 year. Leave blank to
# auto-detect (current year if it's September or later, else last year).
MASHOV_YEAR=

# Only needed later, once fetch.py actually uploads data somewhere —
# not required to run explore.py.
SCHOOL_UPLOAD_URL=
SCHOOL_UPLOAD_TOKEN=
