generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id                  String             @id @default(cuid())
  name                String?
  email               String?            @unique
  phone               String?
  image               String?
  emailVerified       DateTime?
  role                Role               @default(PARENT)
  accessStatus        AccessStatus       @default(PENDING)
  requestedChildName  String?
  parentType          String?            // "אבא" or "אמא"
  createdAt           DateTime           @default(now())
  classId             String?
  studentId           String?            @unique  // for STUDENT role — links to Student record
  widgetToken         String?            @unique  // per-user secret for unauthenticated widget/shortcut fetches (see /api/widget/*) — never a session, generated on demand
  accounts            Account[]
  sentMessages        Message[]
  parentStudents      ParentStudent[]
  sessions            Session[]
  teacherRecords      TeacherRecord[]
  pushSubscriptions   PushSubscription[]
  personalTasks       PersonalTask[]
  staffTasksCreated   StaffTask[]
  teamFilesAdded      TeamFile[]
  teamEventsAdded     TeamEvent[]
  teamPosts           TeamPost[]
  studyMaterialsAdded StudyMaterial[]
  lessonManualDones   LessonManualDone[]
  class               Class?             @relation(fields: [classId], references: [id])
  studentRecord       Student?           @relation(fields: [studentId], references: [id])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @db.Text
  p256dh    String   @db.Text
  auth      String   @db.Text
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, endpoint])
  @@index([userId])
}

enum AccessStatus {
  PENDING
  APPROVED
  DENIED
}

enum Role {
  TEACHER
  PARENT
  STUDENT
  ADMIN
}

model FeatureInterest {
  id        String   @id @default(cuid())
  userId    String
  feature   String
  createdAt DateTime @default(now())

  @@unique([userId, feature])
}

model Class {
  id                   String    @id @default(cuid())
  name                 String
  displayName          String    @default("")   // e.g. "י2 סילבר"
  teacherDisplayName   String    @default("")   // e.g. "אליאב גיל"
  schoolName           String    @default("")   // e.g. "כפר סילבר"
  students             Student[]
  teachers             User[]
  lessonManualDones    LessonManualDone[]
}

model Student {
  id              String                 @id @default(cuid())
  name            String
  idNumber        String?                @unique // ת.ז
  classId         String
  // Self-reported by the student (edited from /student/edit) — not grades,
  // just enough context for the school-logistics assistant bot to answer
  // track-specific questions ("איפה מגמת פיזיקה יושבת") without asking every time.
  track           String?
  mathUnits       Int?
  englishUnits    Int?
  // Imported from the school's own "אלפון" (student directory) export —
  // deliberately a narrow subset, not the whole file: only what the
  // assistant bot needs to greet a student personally and answer about
  // *themselves*. Never surfaced about any other student. idNumber above
  // is also populated by this same import (matches students by name on
  // first run, then by idNumber on any re-run).
  city            String? // ישוב 1 — city/town, not the exact street address
  parent1Name     String?
  parent2Name     String?
  gender          String? // "ז" | "נ" — from אלפון's "מין" column, needed so the assistant bot addresses the student with correct Hebrew grammar
  // From the "קבוצות לימוד" export — one line per subject group the
  // student is actually enrolled in (subject + class range + teacher name),
  // so the assistant bot can answer "who teaches me X" per student. Same
  // narrow-subset, per-student-only principle as the fields above.
  studyGroups     String?  @db.Text
  messages        Message[]
  parents         ParentStudent[]
  class           Class                  @relation(fields: [classId], references: [id])
  records         StudentRecord[]
  grades          StudentGrade[]
  attendance      StudentAttendance?
  userAccount     User?
  accommodations  StudentAccommodation[]
  emotionalNotes  EmotionalNote[]
  surveyCompletions SurveyCompletion[]
}

model ParentStudent {
  userId    String
  studentId String
  student   Student @relation(fields: [studentId], references: [id])
  user      User    @relation(fields: [userId], references: [id])

  @@id([userId, studentId])
}

model Message {
  id                String        @id @default(cuid())
  createdAt         DateTime      @default(now())
  content           String        @db.Text
  senderId          String
  studentId         String
  status            MessageStatus @default(PENDING)
  botResponse       String?       @db.Text
  botAnsweredAt     DateTime?
  dataAsOf          DateTime?
  teacherResponse   String?       @db.Text
  teacherAnsweredAt DateTime?
  skipReason        String?
  flaggedByParent   Boolean       @default(false)
  teacherApproved   Boolean       @default(false)
  teacherSeenAt     DateTime?
  isTask            Boolean       @default(false)
  sender            User          @relation(fields: [senderId], references: [id])
  student           Student       @relation(fields: [studentId], references: [id])

  @@index([teacherSeenAt, createdAt])
  @@index([studentId])
}

enum MessageStatus {
  PENDING
  BOT_ANSWERED
  TEACHER_ANSWERED
  FORWARDED
}

// Legacy import system (kept for compatibility)
model StudentRecord {
  id         String     @id @default(cuid())
  studentId  String
  date       DateTime
  recordType RecordType
  details    String     @db.Text
  importId   String
  import     DataImport @relation(fields: [importId], references: [id])
  student    Student    @relation(fields: [studentId], references: [id])
}

enum RecordType {
  ATTENDANCE
  GRADE
  SCHEDULE
  OTHER
}

model DataImport {
  id          String          @id @default(cuid())
  importedAt  DateTime        @default(now())
  filename    String
  recordCount Int
  records     StudentRecord[]
}

// ── New tables ──────────────────────────────────────────

// Teacher directory (אלפון מורים)
model Teacher {
  id       String  @id @default(cuid())
  name     String
  phone    String?
  mobile   String?
  email    String?
  city     String?
  subjects String? // comma-separated
  role     String?
}

// Per-student per-subject grades with weighted average (ציונים שוטפים)
model StudentGrade {
  id              String   @id @default(cuid())
  studentId       String
  student         Student  @relation(fields: [studentId], references: [id])
  subject         String   // e.g. "אזרחות"
  teacherName     String?
  gradeComponents Json     // array of {name, weight, score}
  weightedAverage Float?
  updatedAt       DateTime @default(now())

  @@unique([studentId, subject])
}

// Attendance counters (מונה התנהגות)
model StudentAttendance {
  id                     String   @id @default(cuid())
  studentId              String   @unique
  student                Student  @relation(fields: [studentId], references: [id])
  totalLessons           Int      @default(0)
  absences               Int      @default(0)
  justifiedAbsences      Int      @default(0)
  tardiness              Int      @default(0)
  justifiedTardiness     Int      @default(0)
  disruptions            Int      @default(0)
  updatedAt              DateTime @default(now())
}

// Class schedule (מערכת כיתתית)
model ScheduleSlot {
  id        String @id @default(cuid())
  classId   String
  dayHeb    String // ראשון, שני, ...
  period    String // "1, 08:45 - 09:30"
  content   String @db.Text // raw cell content (subject + teacher + room, may include splits)

  @@index([classId, dayHeb])
}

// Bell schedule — school-wide period → clock-time mapping (לוח צלצולים).
// Separate from ScheduleSlot.period (which is per-class, per-day subject content and
// may or may not embed its own time range as raw text) — this is the canonical times,
// shared by every class, used to show real start/end times even for schedule rows that
// only give a bare period number.
model BellSlot {
  id        String @id @default(cuid())
  period    String // "1", "2", ... — matched against the leading number in ScheduleSlot.period
  startTime String // "08:45"
  endTime   String // "09:30"
  dayType   String @default("רגיל") // "רגיל" | any label for a shortened/alternate day (e.g. "שישי")
  order     Int    @default(0)

  @@index([dayType, order])
}

// Calendar events — exams, trips, events (לוח מבחנים + לוח פעילויות)
model CalendarEvent {
  id           String   @id @default(cuid())
  date         DateTime
  description  String   @db.Text
  type         String?
  note         String?
  forAll       Boolean  @default(false)
  forTeacher   Boolean  @default(false)
  forGradeTeam Boolean  @default(false)
  forStudents  Boolean  @default(false)
  forParents   Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([date])
}

// Teacher notes — voice-dictated or manual records per student
model TeacherRecord {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  teacherId   String
  classId     String
  classLabel  String
  studentName String
  category    String   // חיסור | איחור | הפרעה | אירוע חיובי | אחר
  note        String?  @db.Text
  source      String   @default("הכתבה קולית") // "הכתבה קולית" | "ידני"
  teacher     User     @relation(fields: [teacherId], references: [id])

  @@index([teacherId, createdAt])
  @@index([classId])
}

// A document a teacher uploaded for the school-logistics assistant bot
// (/api/assistant/chat) — the raw file isn't kept for RAG/search, it's
// processed once at upload time (Claude reads it directly and extracts
// facts as text), and every doc's extractedFacts is concatenated whole
// into the bot's system prompt. Small enough corpus for a school that this
// needs no chunking/embeddings.
model SchoolKnowledgeDoc {
  id             String   @id @default(cuid())
  filename       String
  fileUrl        String   // original file, kept for the admin to re-download/review
  extractedFacts String   @db.Text
  // Teacher-written guidance on how to treat *this specific document* — e.g.
  // "this is the official teacher directory, give out these numbers freely"
  // or "dates here are tentative, say so". Fed to the extraction step as
  // context, and shown alongside the facts in the bot's own system prompt.
  note           String?  @db.Text
  uploadedById   String
  createdAt      DateTime @default(now())
}

// Singleton row (fixed id) holding the teacher's behavioral instructions for
// the assistant bot — tone, what to say when a fact isn't covered, anything
// it should never do. Kept separate from SchoolKnowledgeDoc, which is facts
// only: this is instructions, edited from the same admin page.
model SchoolAssistantSettings {
  id           String   @id @default("default")
  instructions String   @db.Text
  updatedAt    DateTime @updatedAt
}

// A named link the teacher wants the assistant bot able to hand out —
// e.g. a permission-slip form, a registration page — with a description
// of when it's relevant, separate from SchoolKnowledgeDoc facts since
// these are meant to be inserted verbatim into an answer, not summarized.
model SchoolAssistantLink {
  id           String   @id @default(cuid())
  label        String
  url          String
  whenToUse    String   @db.Text
  createdById  String
  createdAt    DateTime @default(now())
}

// A question the assistant bot either couldn't answer confidently
// (reason: dont_know, server-detected from the [[NEEDS_HELP]] marker) or
// that a student flagged as wrong (reason: flagged_wrong) — surfaced to
// the coordinator so the knowledge base/links can be improved. Who asked
// is resolved and stored at write time (not just a userId) so the admin
// list doesn't need extra joins to be useful.
model SchoolAssistantEscalation {
  id          String   @id @default(cuid())
  userId      String
  askerName   String
  askerRole   String
  className   String?
  question    String   @db.Text
  answer      String   @db.Text
  reason      String // "dont_know" | "flagged_wrong"
  resolved    Boolean  @default(false)
  createdAt   DateTime @default(now())
}

// Bot response cache — avoid repeat Claude calls for identical questions
model BotCache {
  id        String   @id @default(cuid())
  userId    String
  question  String   @db.Text
  answer    String   @db.Text
  fromBot   String   @default("student") // "student" | "parent" | "assistant"
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// ── Teacher-entered tasks (not from chat) ─────────────────
// Superseded by PersonalTask/StaffTask below (this one is classId-scoped —
// shared by whoever happens to share a class — rather than owned by a
// specific teacher). Left in place, unused by new code, rather than
// migrating/dropping it.
model TeacherTask {
  id          String    @id @default(cuid())
  classId     String
  description String    @db.Text
  responsible String?
  deadline    DateTime?
  note        String?   @db.Text
  done        Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([classId, done])
}

enum TaskImportance {
  RED
  YELLOW
  BLUE
}

// ── A teacher's own personal to-dos ───────────────────────
model PersonalTask {
  id           String         @id @default(cuid())
  userId       String
  title        String         @db.Text
  link         String?        @db.Text
  deadline     DateTime?
  importance   TaskImportance @default(BLUE)
  reminderAt   DateTime?
  reminderSent Boolean        @default(false)
  done         Boolean        @default(false)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, done])
}

// ── Tasks a coordinator assigns to one or more homeroom teachers ──
model StaffTask {
  id          String              @id @default(cuid())
  createdById String
  title       String              @db.Text
  link        String?             @db.Text
  deadline    DateTime?
  note        String?             @db.Text // general note on the task, separate from any per-assignee note
  importance  TaskImportance      @default(BLUE)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  createdBy   User                @relation(fields: [createdById], references: [id], onDelete: Cascade)
  assignees   StaffTaskAssignee[]

  @@index([createdById])
}

// Assignees are tracked by display name (teacherLabel), since the homeroom
// teachers this gets assigned to don't have real accounts yet — userId is
// filled in once a matching account exists, letting that teacher see and
// check off the task themselves instead of the coordinator doing it for them.
model StaffTaskAssignee {
  id           String    @id @default(cuid())
  staffTaskId  String
  teacherLabel String
  userId       String?
  done         Boolean   @default(false)
  note         String?   @db.Text // e.g. "will finish by Thursday" — visible next to this teacher only
  reminderAt   DateTime?
  reminderSent Boolean   @default(false)
  staffTask    StaffTask @relation(fields: [staffTaskId], references: [id], onDelete: Cascade)

  @@index([staffTaskId])
  @@index([userId])
}

// ── Grade-team coordination page (מחנכי צוות) ─────────────
// A shared-tasks list already exists (StaffTask above) and is reused as-is
// on the team page rather than duplicated — these three are the genuinely
// new pieces: a manually-curated list of Drive links, a small team-only
// events list (meetings, internal deadlines — not the school-wide
// calendar), and a flat announcements feed.
model TeamFile {
  id          String   @id @default(cuid())
  title       String
  url         String   @db.Text
  createdById String
  createdAt   DateTime @default(now())
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([createdById])
}

model TeamEvent {
  id          String   @id @default(cuid())
  title       String
  date        DateTime
  link        String?  @db.Text
  createdById String
  createdAt   DateTime @default(now())
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([createdById])
  @@index([date])
}

model TeamPost {
  id        String   @id @default(cuid())
  content   String   @db.Text
  authorId  String
  createdAt DateTime @default(now())
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([authorId])
}

// A manually-curated list of study-material links for the civics subject
// page (/teacher/civics) — first pass is just a titled link list, same
// shape as TeamFile; expected to grow beyond that later.
model StudyMaterial {
  id          String   @id @default(cuid())
  title       String
  url         String   @db.Text
  createdById String
  createdAt   DateTime @default(now())
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([createdById])
}

// Manual override for /lessons/results' "מעקב שיעורים" tracker. That
// tracker infers a lesson as "done" for a class purely from whether a live
// session row exists for it in the (separate, Supabase-hosted) lessons DB
// — but a teacher who taught the material without finishing the slide deck,
// or without going through the live-session flow at all, has no such row.
// lessonId points at that Supabase lessons table (cross-database — no FK
// here), classId is this app's own Class.
model LessonManualDone {
  id          String   @id @default(cuid())
  lessonId    String
  classId     String
  markedById  String
  createdAt   DateTime @default(now())
  markedBy    User     @relation(fields: [markedById], references: [id], onDelete: Cascade)
  class       Class    @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([lessonId, classId])
  @@index([classId])
}

// ── Student personal accommodations ──────────────────────
model StudentAccommodation {
  id          String   @id @default(cuid())
  studentId   String
  classId     String
  type        String   // "private_lesson" | "therapy" | "special_activity" | "other"
  description String   @db.Text
  provider    String?
  subject     String?
  dayHeb      String?
  timeSlot    String?
  note        String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  student     Student  @relation(fields: [studentId], references: [id])

  @@index([classId])
  @@index([studentId])
}

// ── Questionnaires / surveys (Google Forms links for now) ─
model Survey {
  id                String             @id @default(cuid())
  title             String
  url               String             @db.Text
  classId           String?            // null = visible to every class
  dueDate           DateTime?
  // Optional link to the Google Sheet the linked Form writes responses to —
  // lets completion be verified against real submissions instead of relying
  // only on student self-report. The same sheet is often shared by several
  // classes' surveys at once, so a "class" answer column in the form is what
  // tells one Survey's sync which rows are actually its own.
  responseSheetUrl  String?            @db.Text
  lastSyncedAt      DateTime?
  createdAt         DateTime           @default(now())
  completions       SurveyCompletion[]

  @@index([classId])
}

model SurveyCompletion {
  id          String   @id @default(cuid())
  surveyId    String
  studentId   String
  completedAt DateTime @default(now())
  // true once matched against a real response row in the linked sheet;
  // false means it's still only the student's own say-so.
  verified    Boolean  @default(false)
  survey      Survey   @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([surveyId, studentId])
  @@index([studentId])
}

// ── Emotional-social tracking ─────────────────────────────
model EmotionalNote {
  id        String   @id @default(cuid())
  studentId String
  classId   String
  type      String   @default("teacher") // "teacher" | "parent" | "survey"
  content   String   @db.Text
  score     Int?     // 1–5 wellbeing score
  date      DateTime @default(now())
  createdAt DateTime @default(now())
  student   Student  @relation(fields: [studentId], references: [id])

  @@index([classId, date])
  @@index([studentId])
}

// ── Mashov behave-log sync ────────────────────────────────
// One row per tracked behave event (חיסור / הפרת משמעת / הערה חיובית —
// see achvaCode) pulled from Mashov's per-class behave log. mashovKey
// dedupes so the polling cron only pushes a notification the first time
// it sees a given event. Table name kept as MashovAbsenceEvent (via @@map)
// since it predates achvaCode/achvaName and renaming would need a real
// table rename migration for no functional benefit.
model MashovBehaveEvent {
  id           String    @id @default(cuid())
  mashovKey    String    @unique
  achvaCode    Int       @default(1)
  achvaName    String    @default("חיסור")
  studentName  String
  classCode    String
  classNum     Int
  subjectName  String
  lessonDate   DateTime
  lessonNum    Int
  reportedAt   DateTime
  justified    Boolean   @default(false)
  notifiedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([classCode, classNum])
  @@index([achvaCode])
  @@map("MashovAbsenceEvent")
}
